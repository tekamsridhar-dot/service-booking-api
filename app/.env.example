
# Database Configuration

DATABASE_URL=postgresql://postgres:your_password@db:5432/service_booking_db

# JWT Authentication


SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# Email Configuration

MAIL_USERNAME=[your_email@example.com](mailto:your_email@example.com)
MAIL_PASSWORD=your_email_password
MAIL_FROM=[your_email@example.com](mailto:your_email@example.com)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Application Settings

APP_NAME=Service Booking API
DEBUG=True

# File Uploads

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
